{
  "name": "@minitype/vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for minitype — live preview with HMR.",
  "author": "Yuto Wada",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx build.ts && tsc --emitDeclarationOnly && tsc-alias",
    "watch": "tsx build.ts --watch",
    "check": "biome check ./src --write"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@minitype/minitype": "../minitype",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "pdfjs-dist": "^5.6.205"
  }
}
